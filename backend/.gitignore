## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# .NET Core
.project
.vs/
.vscode/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / JetBrains
.idea/
*.sln.iml

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# NuGet packages
*.nupkg
# Uncomment if you don't want packages restored automatically
# /packages/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Secrets
secrets.json
appsettings.*.json
!appsettings.json

# Publish output
/publish/
/wwwroot/lib/

# IIS
*.iisexpress

# Test results
TestResults/

# Coverage
coverage/
coverage.cobertura.xml

# Azure
.azure/
