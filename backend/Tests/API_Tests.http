@baseUrl = https://localhost:5001/api
@token = 

### ========================
### AUTHENTICATION
### ========================

### Register new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "email": "test@example.com",
  "password": "Password123!",
  "confirmPassword": "Password123!",
  "phoneNumber": "0123456789",
  "dateOfBirth": "1990-01-01",
  "gender": "Male",
  "address": "123 Đường ABC",
  "city": "Hà Nội"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}

### Get current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### ========================
### INSURANCE CATEGORIES
### ========================

### Get all categories
GET {{baseUrl}}/insurancecategory

### Create category (Admin/Employee)
POST {{baseUrl}}/insurancecategory
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryName": "Bảo hiểm nhân thọ",
  "description": "Bảo hiểm cho cuộc sống"
}

### ========================
### INSURANCE SCHEMES
### ========================

### Get all schemes
GET {{baseUrl}}/insurancescheme?isActive=true

### Create scheme (Admin/Employee)
POST {{baseUrl}}/insurancescheme
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 1,
  "schemeName": "Gói An Sinh Vàng",
  "description": "Bảo hiểm toàn diện cho cuộc sống",
  "minTerm": 5,
  "maxTerm": 30,
  "minInvestmentAmount": 10000000,
  "maxInvestmentAmount": 1000000000,
  "profitRatio": 5.5,
  "isActive": true
}

### Calculate premium
POST {{baseUrl}}/insurancescheme/calculate-premium
Content-Type: application/json

{
  "schemeId": 1,
  "sumAssured": 100000000,
  "termYears": 10,
  "paymentFrequency": "Monthly"
}

### ========================
### POLICIES
### ========================

### Get my policies
GET {{baseUrl}}/policy/my-policies?activeOnly=true
Authorization: Bearer {{token}}

### Create Life Insurance Policy
POST {{baseUrl}}/policy
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "schemeId": 1,
  "termYears": 10,
  "paymentFrequency": "Monthly",
  "sumAssured": 100000000,
  "lifeDetails": {
    "nomineeName": "Nguyễn Thị B",
    "nomineeRelation": "Wife"
  }
}

### Create Medical Insurance Policy
POST {{baseUrl}}/policy
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "schemeId": 2,
  "termYears": 1,
  "paymentFrequency": "Yearly",
  "sumAssured": 50000000,
  "medicalDetails": {
    "preExistingDiseases": "None",
    "hospitalNetworkTier": "Premium",
    "isFamilyFloater": true
  }
}

### Create Motor Insurance Policy
POST {{baseUrl}}/policy
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "schemeId": 3,
  "termYears": 1,
  "paymentFrequency": "Yearly",
  "sumAssured": 30000000,
  "motorDetails": {
    "vehicleRegNumber": "29A-12345",
    "vehicleModel": "Honda City",
    "vehicleType": "Sedan",
    "engineNumber": "ENG123456",
    "chassisNumber": "CHS123456",
    "manufacturingYear": 2020
  }
}

### Create Home Insurance Policy
POST {{baseUrl}}/policy
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "schemeId": 4,
  "termYears": 5,
  "paymentFrequency": "Yearly",
  "sumAssured": 200000000,
  "homeDetails": {
    "propertyAddress": "123 Main Street, District 1, HCMC",
    "propertyValue": 200000000,
    "structureType": "Concrete",
    "builtYear": 2015
  }
}

### ========================
### CLAIMS
### ========================

### Get my claims
GET {{baseUrl}}/claim/my-claims
Authorization: Bearer {{token}}

### Submit claim
POST {{baseUrl}}/claim
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "policyId": 1,
  "claimAmount": 5000000,
  "reason": "Hospitalization due to accident"
}

### Update claim status (Admin/Employee)
PATCH {{baseUrl}}/claim/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Approved",
  "adminComment": "Claim approved after document verification"
}

### ========================
### PREMIUM PAYMENTS
### ========================

### Get my payments
GET {{baseUrl}}/premiumpayment/my-payments
Authorization: Bearer {{token}}

### Make payment
POST {{baseUrl}}/premiumpayment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "policyId": 1,
  "amountPaid": 45833.33,
  "paymentMethod": "CreditCard"
}

### ========================
### POLICY LOANS
### ========================

### Get my loans
GET {{baseUrl}}/policyloan/my-loans
Authorization: Bearer {{token}}

### Apply for loan
POST {{baseUrl}}/policyloan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "policyId": 1,
  "loanAmount": 40000000
}

### Update loan status (Admin/Employee)
PATCH {{baseUrl}}/policyloan/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "loanStatus": "Approved"
}

### ========================
### NEWS
### ========================

### Get all news
GET {{baseUrl}}/news

### Create news (Admin/Employee)
POST {{baseUrl}}/news
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Chương trình khuyến mãi tháng 2",
  "content": "Giảm 20% phí bảo hiểm cho khách hàng mới đăng ký trong tháng 2"
}

### Update news (Admin/Employee)
PUT {{baseUrl}}/news/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Chương trình khuyến mãi tháng 2 - Cập nhật",
  "content": "Giảm 20% phí bảo hiểm cho khách hàng mới đăng ký trong tháng 2. Áp dụng cho tất cả các gói bảo hiểm."
}
